# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API Keys.
# Only the publishable key goes in the app. The secret key is for the scraper (GitHub secret).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
